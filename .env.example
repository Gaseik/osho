# Groq API Key (for AI card reading)
GROQ_API_KEY=

# Groq models used for AI readings — server-side only (no NEXT_PUBLIC_ prefix).
#
# Format: comma-separated model IDs. Order is priority: the first entry is the
# primary model, the rest are fallbacks that are only tried when a model turns
# out to be unavailable (HTTP 404 / model_not_found). Any other error
# (rate limit, auth, payload too large) is surfaced as-is and never falls back.
#
# Required — there is no hardcoded default. If this is unset, /api/reading
# responds 500 { "error": { "code": "CONFIG_ERROR" } } and logs
# "GROQ_MODELS is not configured".
#
# Check the currently served model IDs at https://console.groq.com/docs/models
# Example:
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-20b
GROQ_MODELS=
